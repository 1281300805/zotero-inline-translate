{
  "name": "zotero-inline-translate",
  "type": "module",
  "version": "0.4.40",
  "description": "Translate selected PDF text and display the translation in place.",
  "config": {
    "addonName": "Inline Translate for Zotero",
    "addonID": "inline-translate@readpaper.local",
    "addonRef": "inlinetranslate",
    "addonInstance": "InlineTranslate",
    "prefsPrefix": "extensions.zotero.inlinetranslate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1281300805/zotero-inline-translate.git"
  },
  "author": "1281300805",
  "homepage": "https://github.com/1281300805/zotero-inline-translate",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:unit": "mocha test/annotationMapping.test.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
